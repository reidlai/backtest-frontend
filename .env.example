# Copy to .env for local development
# PUBLIC_* variables are exposed to the browser via SvelteKit's $env/dynamic/public.
# They are read at runtime (not baked in at build time), so Docker containers can
# override them with -e / docker-compose environment: without rebuilding the image.

# URL of the backtest-eapi backend (no trailing slash)
PUBLIC_BACKTEST_EAPI_URL=http://localhost:8080

# JWT Bearer token for backtest-eapi authentication.
# The backend validates token presence only (demo-level) — any non-empty value works locally.
# In production, supply a valid signed JWT issued by your identity provider.
PUBLIC_BACKTEST_EAPI_TOKEN=dev-token

# Set to "true" to serve all state from shared-mockdata (no API calls).
# Set to "false" or leave unset to fetch live data from the backend API via RxJS streams.
# Resources without RxJS streams (trades, performance, screener, etc.) always use mock data
# regardless of this flag until their API integration is implemented.
PUBLIC_USE_MOCK_DATA=true
