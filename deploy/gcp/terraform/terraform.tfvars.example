# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

# Required: GCP project ID
project_id = "my-gcp-project-id"

# GCP region for the Cloud Run service
region = "us-central1"

# Cloud Run service name (used as the resource identifier)
service_name = "backtest-frontend"

# Docker image tag from ghcr.io/reidlai/backtest-frontend
# Use "main" for the latest main branch build, or a short SHA for a pinned version
image_tag = "main"

# Scaling configuration (scale-to-zero by default)
min_instances = 0
max_instances = 10

# Container resource limits
cpu    = "1"
memory = "512Mi"

# Non-sensitive environment variables injected into the container at runtime
# Remove the block entirely if no env vars are needed
env_vars = {
  # Required: backend API base URL (no trailing slash)
  PUBLIC_BACKTEST_EAPI_URL = "https://backtest-eapi-<project-number>.<region>.run.app"

  # Required: bearer token the frontend passes to the eAPI
  PUBLIC_BACKTEST_EAPI_TOKEN = "<your-api-token>"

  # Set to "true" to serve mock data instead of live API calls.
  # Must be "false" (or omitted) in production so the app hits the real eAPI.
  PUBLIC_USE_MOCK_DATA = "false"
}

# Artifact Registry remote repository name (proxies ghcr.io)
artifact_registry_repo = "ghcr-proxy"

# GitHub Personal Access Token with read:packages scope
# Used by Artifact Registry to authenticate to ghcr.io for private image pulls
# This value is stored in GCP Secret Manager by Terraform — never commit it
github_token = "<your-github-pat-with-read-packages-scope>"
